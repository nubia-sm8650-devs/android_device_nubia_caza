<compatibility-matrix version="2.0" type="framework">
    <hal format="aidl" optional="true" >
        <name>vendor.goodix.hardware.biometrics.fingerprint</name>
        <version>1</version>
        <interface>
            <name>IGoodixFingerprintDaemon</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true" >
        <name>vendor.zte.fingerprint.ifaaaidl</name>
        <version>1</version>
        <interface>
            <name>IIfaaAidlDaemon</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true" >
        <name>vendor.zte.hardware.camera.transfer</name>
        <version>1</version>
        <interface>
            <name>ITransfer</name>
            <instance>vendor_zte/0</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true" >
        <name>vendor.zte.modem</name>
        <version>1</version>
        <interface>
            <name>IModem</name>
            <instance>instance0</instance>
            <instance>instance1</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true" >
        <name>vendor.zte.radio</name>
        <version>1</version>
        <interface>
            <name>IVendorRadio</name>
            <instance>slot1</instance>
            <instance>slot2</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true" >
        <name>vendor.zte.subsys</name>
        <version>1</version>
        <interface>
            <name>ISubsys</name>
            <instance>subsys</instance>
        </interface>
    </hal>
</compatibility-matrix>
